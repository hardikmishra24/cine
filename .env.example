# GEMINI_API_KEY: Required for Gemini AI API calls (Research, Script, TTS, Transcription).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional secondary neural TTS provider key (server-side only).
ELEVENLABS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
